{
  "manifest_version": 3,
  "name": "Kata – Private Offline Translator",
  "short_name": "Kata",
  "version": "0.1.0",
  "description": "Private translation that runs on your computer. Small AI models, no servers, works offline after a one-time download.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Kata",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "scripting", "contextMenus", "offscreen", "storage", "unlimitedStorage"],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Translate selected text"
    },
    "translate-field": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Translate what you typed in the current text box"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
